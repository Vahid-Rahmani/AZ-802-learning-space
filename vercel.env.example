# Server-only values required for registration/login on Vercel.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google sign-in (Google OAuth Web application credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://az-802-eosin.vercel.app/api/auth/google/callback

# Password recovery by email. Use Resend OR a trusted delivery webhook.
APP_ORIGIN=https://az-802-eosin.vercel.app
RESEND_API_KEY=
RESET_FROM_EMAIL=
# RESET_EMAIL_WEBHOOK_URL=

# AI explanations are local and require no Google/Gemini API key.
# The UI can optionally open the user's free Google AI Mode web session.
